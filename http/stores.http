@baseUrl = http://localhost:8080
@configuredMax = 5

### Default count and ascending distances
GET {{baseUrl}}/api/stores/nearest?latitude=52.0907&longitude=5.1214
Accept: application/json

> {%
    client.test("Default count and ordering", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        const stores = response.body.stores;
        client.assert(stores.length === Number(request.variables.get("configuredMax")), "Configured default count");
        for (let i = 1; i < stores.length; i++) {
            client.assert(stores[i - 1].distanceKm <= stores[i].distanceKm, "Distances must be ascending");
        }
    });
%}

### Exact known store location
GET {{baseUrl}}/api/stores/nearest?latitude=51.778461&longitude=4.615551
Accept: application/json

> {%
    client.test("Exact store location ranks first", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.stores.length === Number(request.variables.get("configuredMax")), "Configured count");
        client.assert(response.body.stores[0].id === "EOgKYx4XFiQAAAFJa_YYZ4At", "Expected known store");
        client.assert(response.body.stores[0].distanceKm === 0, "Distance at same location is zero");
    });
%}

### Valid coordinates outside coverage still produce results
GET {{baseUrl}}/api/stores/nearest?latitude=0&longitude=0
Accept: application/json

> {%
    client.test("Outside coverage still returns stores", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.stores.length === Number(request.variables.get("configuredMax")), "Results are still returned");
    });
%}

### Missing required coordinate returns 400
GET {{baseUrl}}/api/stores/nearest?latitude=52.0907
Accept: application/json, application/problem+json

> {%
    client.test("Missing coordinate returns a problem", function () {
        client.assert(response.status === 400, "Expected HTTP 400");
        client.assert(response.body.detail === "Required query parameter 'longitude' is missing.", "Problem names longitude");
        client.assert(response.body.instance === "/api/stores/nearest", "Problem instance");
    });
%}

### Globally out-of-range coordinate returns 400
GET {{baseUrl}}/api/stores/nearest?latitude=91&longitude=5.1214
Accept: application/json, application/problem+json

> {%
    client.test("Out-of-range coordinate returns a problem", function () {
        client.assert(response.status === 400, "Expected HTTP 400");
        client.assert(response.body.detail === "Query parameter 'latitude' must be a number between -90 and 90.", "Problem names latitude");
    });
%}

### Minimal health endpoint
GET {{baseUrl}}/actuator/health
Accept: application/json

> {%
    client.test("Health endpoint is available", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.status === "UP", "Application is healthy");
    });
%}
